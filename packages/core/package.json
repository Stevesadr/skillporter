{
  "name": "@skillporter/core",
  "version": "0.1.0",
  "description": "Skill IR, parsers, detection and diagnostics for skillporter.",
  "license": "Apache-2.0",
  "author": "Stevesadr (https://github.com/Stevesadr)",
  "homepage": "https://github.com/Stevesadr/skillporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stevesadr/skillporter.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Stevesadr/skillporter/issues"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "SKILL.md",
    "intermediate-representation",
    "parser",
    "conversion"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-package-data.mjs",
    "postpack": "node ../../scripts/clean-package-data.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.3",
    "yaml": "^2.6.1"
  }
}
