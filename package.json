{
  "name": "skillporter-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Convert AI agent skills between agent-specific formats, with an explicit fidelity report.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "clean": "tsc -b --clean",
    "validate:profiles": "node scripts/validate-profiles.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:only": "node --test tests/*.test.mjs",
    "inspect": "node packages/cli/dist/index.js inspect"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
